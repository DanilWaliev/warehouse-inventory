{{template "base" .}}

{{/* Каждый блок - карточка .card */}}
{{/* Данные для шаблона: .TMC, .Products, .Recipes, .Orders */}}

{{define "title"}}Произодство{{end}}

{{ define "main" }}
<main>

  <!-- Обёртка под хедером: слева меню, справа контент -->
  <div class="page" id="page-root">

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <ul>
        <li data-tab="recipe">Рецептуры</li>
        <li data-tab="order">Заказы</li>
      </ul>
    </aside>

    <!-- Content -->
    <section class="content">

      <!-- Верхняя панель: заголовок секции и кнопка Добавить -->
      <div class="topbar">
        <h2 id="section-title">Рецептуры</h2>
        <div>
          <button class="btn btn-primary" id="addBtn">Добавить</button>
        </div>
      </div>

      <!-- Карточка со списком: внутри таблицы.
           Здесь мы выводим 2 таблицы (по одной на сущность) и показываем только активную -->
      <div class="card item-list">
        <div class="table-wrap">
          <!-- Рецептуры -->
          <table class="table tab-table hidden" id="table-recipe">
            <thead>
              <tr>
                <th>Результат</th>
                <th>Тип</th>
                <th>Состав</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody id="table-recipe-body">
              
            </tbody>
          </table>

          <!-- Заказы -->
          <table class="table tab-table hidden" id="table-order">
            <thead>
              <tr>
                <th>ID</th>
                <th>Рецептуры</th>
                <th>Статус</th>
                <th>Дата открытия</th>
                <th>Дата завершения</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody id="table-order-body">
  
            </tbody>
          </table>

              
          </table>

        </div>
      </div>

    </section>
  </div>

  <!-- Модальное окно: содержит 3 формы, и показывается форма соответствующей вкладке -->
  <div id="modal" class="modal hidden" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-content" role="document">
      <!-- Общий заголовок модалки -->
      <h3 id="modal-title" class="mb-4">Добавить</h3>
      <!-- Форма: Рецептура -->
      <form id="form-recipe" class="modal-form" data-mode="create" data-id="">
        <div class="mb-4">
          <label>Результат</label>
          <select name="result-tmc-id" id="result-tmc" class="w-full"></select>
        </div>

        <div class="mb-4">
          <p><label>Ингредиенты</label></p>
          <div id="ingredients-list">
            <div class="ingredient-row">
              <select name="ingredient-id">...</select>
              <input type="number" name="ingredient-qty" min="1" value="1">
            </div>
          </div>
          <button type="button" class="btn btn-secondary mt-2" id="add-ingredient">+ Добавить</button>
        </div>

          <div class="flex justify-end gap-2">
            <button type="button" class="btn" id="modal-cancel-2">Отмена</button>
            <button type="submit" class="btn btn-primary">Сохранить</button>
          </div>
      </form>

      <!-- Форма: Заказ -->
      <form id="form-order" class="modal-form hidden" data-mode="create" data-id="">
        <div class="mb-4">
          <p><label>Рецептуры</label></p>
          <div id="order-items-list"></div>
          <button type="button" class="btn btn-secondary mt-2" id="add-order-item">+ Добавить</button>
        </div>

        <div class="flex justify-end gap-2">
          <button type="button" class="btn" id="modal-cancel-3">Отмена</button>
          <button type="submit" class="btn btn-primary">Создать</button>
        </div>
      </form>

    </div>
  </div>
</main>
<script type="module" src="/static/js/pages/production/main.js"></script>
{{ end }}
