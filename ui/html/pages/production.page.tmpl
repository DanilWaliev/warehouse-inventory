{{template "base" .}}

{{/* Каждый блок - карточка .card */}}
{{/* Данные для шаблона: .TMC, .Products, .Recipes, .Orders */}}

{{define "title"}}Произодство{{end}}

{{ define "main" }}
<main>

  <!-- Обёртка под хедером: слева меню, справа контент -->
  <div class="page" id="page-root">

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <ul>
        <li class="active" data-tab="tmc">ТМЦ</li>
        <li data-tab="recipe">Рецептуры</li>
        <li data-tab="order">Заказы</li>
      </ul>
    </aside>

    <!-- Content -->
    <section class="content">

      <!-- Верхняя панель: заголовок секции и кнопка Добавить -->
      <div class="topbar">
        <h2 id="section-title">ТМЦ</h2>
        <div>
          <button class="btn btn-primary" id="addBtn">Добавить</button>
        </div>
      </div>

      <!-- Карточка со списком: внутри таблицы.
           Здесь мы выводим 3 таблицы (по одной на сущность) и показываем только активную -->
      <div class="card item-list">
        <div class="table-wrap">

          <!-- ТМЦ -->
          <table class="table tab-table" id="table-tmc">
            <thead>
              <tr>
                <th>Название</th>
                <th>Вес (кг)</th>
                <th>Тип</th>
                <th>Заметка</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody id="table-tmc-body">
              
            </tbody>
          </table>

          <!-- Рецептуры -->
          <table class="table tab-table hidden" id="table-recipe">
            <thead>
              <tr>
                <th>Результат (ТМЦ)</th>
                <th>Тип</th>
                <th>Состав</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody>
              {{ range .Recipes }}
              <tr data-id="{{ .ID }}">
                <td>{{ .ResultName }}</td>
                <td>{{ .Type }}</td>
                <td class="text-muted">
                  {{ range .Ingredients }}
                    {{ .Name }} ({{ .Quantity }})<br>
                  {{ end }}
                </td>
                <td><form method="post" action="/recipe/delete" onsubmit="return confirm('Удалить?')"><input type="hidden" name="id" value="{{ .ID }}"><button type="submit" class="btn-delete">Удалить</button></form></td>
              </tr>
              {{ else }}
              <tr><td colspan="4" class="text-muted">Нет рецептур</td></tr>
              {{ end }}
            </tbody>
          </table>

          <!-- Заказы -->
          <table class="table tab-table hidden" id="table-order">
            <thead>
              <tr>
                <th>Рецептура</th>
                <th>Количество</th>
                <th>Статус</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody>
              {{ range .Orders }}
              <tr data-id="{{ .ID }}">
                <td>{{ .RecipeName }}</td>
                <td>{{ .Quantity }}</td>
                <td>{{ .Status }}</td>
                <td>
                  {{ if eq .Status "open" }}
                    <form method="post" action="/order/close" style="display:inline;"><input type="hidden" name="id" value="{{ .ID }}"><button type="submit" class="btn-delete">Закрыть</button></form>
                    <form method="post" action="/order/delete" style="display:inline;"><input type="hidden" name="id" value="{{ .ID }}"><button type="submit" class="btn-delete">Удалить</button></form>
                  {{ else }}
                    <form method="post" action="/order/delete"><input type="hidden" name="id" value="{{ .ID }}"><button type="submit" class="btn-delete">Удалить</button></form>
                  {{ end }}
                </td>
              </tr>
              {{ else }}
              <tr><td colspan="4" class="text-muted">Нет заказов</td></tr>
              {{ end }}
            </tbody>
          </table>

        </div>
      </div>

    </section>
  </div>

  <!-- Модальное окно: содержит 3 формы, и показывается форма соответствующей вкладке -->
  <div id="modal" class="modal hidden" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-content" role="document">
      <!-- Общий заголовок модалки -->
      <h3 id="modal-title" class="mb-4">Добавить</h3>

      <!-- Форма: ТМЦ -->
      <form id="form-tmc" class="modal-form">
        <div class="mb-4">
          <input name="name" type="text" required class="w-full" placeholder="Название">
        </div>
        <div class="mb-4">
          <input name="weight" type="number" step="0.01" required class="w-full" placeholder="Вес (кг)">
        </div>
        <div class="mb-4">
          <select name="type" class="w-full">
            <option value="raw">Сырье</option>
            <option value="semi">Полуфабрикат</option>
            <option value="product">Продукт</option>
          </select>
        </div>
        <div class="mb-4">
          <p><label>Заметка</label></p>
          <textarea name="note" class="w-full"></textarea>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn" id="modal-cancel">Отмена</button>
          <button type="submit" class="btn btn-primary">Сохранить</button>
        </div>
      </form>

      <!-- Форма: Рецептура -->
      <form id="form-recipe" class="modal-form hidden">
        <div class="mb-4">
          <label>Результирующий ТМЦ</label>
          <select name="tmc_id" class="w-full">
            {{ range .TMC }}
              <option value="{{ .ID }}">{{ .Name }}</option>
            {{ end }}
          </select>
        </div>
        <div class="mb-4">
          <label>Тип (полуфаб/продукт)</label>
          <select name="type" class="w-full">
            <option value="semi">Полуфабрикат</option>
            <option value="product">Продукт</option>
          </select>
        </div>

        <div id="recipe-ingredients">
          <div class="mb-2 flex gap-2">
            <select name="ingredients[0].tmc_id" class="w-2/3">
              {{ range .TMC }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
            </select>
            <input name="ingredients[0].quantity" type="number" step="0.01" placeholder="Кол-во" class="w-1/3">
          </div>
        </div>

        <div class="mb-4">
          <button type="button" class="btn" id="add-ingredient">+ добавить компонент</button>
        </div>

        <div class="flex justify-end gap-2">
          <button type="button" class="btn" id="modal-cancel-2">Отмена</button>
          <button type="submit" class="btn btn-primary">Сохранить</button>
        </div>
      </form>

      <!-- Форма: Заказ -->
      <form id="form-order" class="modal-form hidden">
        <div class="mb-4">
          <label>Рецептура</label>
          <select name="recipe_id" class="w-full">
            {{ range .Recipes }}<option value="{{ .ID }}">{{ .ResultName }}</option>{{ end }}
          </select>
        </div>
        <div class="mb-4">
          <label>Количество</label>
          <input name="quantity" type="number" step="1" required class="w-full">
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn" id="modal-cancel-3">Отмена</button>
          <button type="submit" class="btn btn-primary">Создать</button>
        </div>
      </form>

    </div>
  </div>
<script src="/static/js/pages/production.js"></script>
{{ end }}
