{{template "base" .}}

{{/* Каждый блок - карточка .card */}}
{{/* Данные для шаблона: .TMC, .Products, .Recipes, .Orders */}}

{{define "title"}}Произодство{{end}}

{{ define "main" }}
<main class="container layout">

  <!-- Левое вертикальное меню -->
  <aside class="card p-4 sidebar">
    <nav>
      <button class="btn btn-primary" onclick="showTab('tmc')">ТМЦ</button>
      <button class="btn btn-primary" onclick="showTab('recipe')">Рецептуры</button>
      <button class="btn btn-primary" onclick="showTab('order')">Заказы</button>
    </nav>
  </aside>

  <!-- Правая рабочая зона -->
  <section class="content">

    <!-- Вкладка: ТМЦ -->
    <div id="tab-tmc" class="tab-content">
      <div class="card mb-4">
        <h2 class="mb-4">Добавить новый ТМЦ</h2>
        <form method="post" action="/tmc/create" class="flex flex-col gap-4">
          <input type="text" name="name" placeholder="Название" required>
          <input type="number" name="weight" step="0.01" placeholder="Вес (кг)" required>
          <select name="type" required>
            <option value="raw">Сырьё</option>
            <option value="semi">Полуфабрикат</option>
            <option value="product">Продукт</option>
          </select>
          <textarea name="note" placeholder="Заметка"></textarea>
          <button type="submit" class="btn btn-primary mt-2">Добавить</button>
        </form>
      </div>

      <div class="card">
        <h3 class="mb-4">Список ТМЦ</h3>
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left p-2">Название</th>
              <th class="text-left p-2">Вес (кг)</th>
              <th class="text-left p-2">Тип</th>
              <th class="text-left p-2">Заметка</th>
            </tr>
          </thead>
          <tbody>
            {{ range .TMC }}
            <tr>
              <td class="p-2">{{ .Name }}</td>
              <td class="p-2">{{ .Weight }}</td>
              <td class="p-2">{{ .Type }}</td>
              <td class="p-2">{{ .Note }}</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Вкладка: Рецептуры -->
    <div id="tab-recipe" class="tab-content hidden">
      <div class="card mb-4">
        <h2 class="mb-4">Создать рецептуру</h2>
        <form method="post" action="/recipe/create" class="flex flex-col gap-4">
          <div>
            <label class="text-bold">ТМЦ (результат)</label>
            <select name="tmc_id" required>
              {{ range .TMC }}
                <option value="{{ .ID }}">{{ .Name }}</option>
              {{ end }}
            </select>
          </div>

          <div>
            <label class="text-bold">Тип</label>
            <select name="type" required>
              <option value="semi">Полуфабрикат</option>
              <option value="product">Продукт</option>
            </select>
          </div>

          <div id="ingredients-list" class="mb-4">
            <div class="flex gap-2 mb-2">
              <select name="ingredients[0].tmc_id" required>
                {{ range .TMC }}
                  <option value="{{ .ID }}">{{ .Name }}</option>
                {{ end }}
              </select>
              <input type="number" name="ingredients[0].quantity" placeholder="Количество" required>
            </div>
          </div>

          <button type="button" class="btn bg-primary text-white" onclick="addIngredient()">+ Добавить ТМЦ</button>
          <button type="submit" class="btn btn-primary mt-2">Сохранить рецептуру</button>
        </form>
      </div>

      <div class="card">
        <h3 class="mb-4">Список рецептур</h3>
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left p-2">ID</th>
              <th class="text-left p-2">ТМЦ</th>
              <th class="text-left p-2">Тип</th>
              <th class="text-left p-2">Состав</th>
            </tr>
          </thead>
          <tbody>
            {{ range .Recipes }}
            <tr>
              <td class="p-2">{{ .ID }}</td>
              <td class="p-2">{{ .ResultName }}</td>
              <td class="p-2">{{ .Type }}</td>
              <td class="p-2">
                {{ range .Ingredients }}
                  {{ .Name }} ({{ .Quantity }})<br>
                {{ end }}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Вкладка: Заказы -->
    <div id="tab-order" class="tab-content hidden">
      <div class="card mb-4">
        <h2 class="mb-4">Создать производственный заказ</h2>
        <form method="post" action="/order/create" class="flex flex-col gap-4">
          <div>
            <label class="text-bold">Рецептура</label>
            <select name="recipe_id" required>
              {{ range .Recipes }}
                <option value="{{ .ID }}">{{ .ResultName }}</option>
              {{ end }}
            </select>
          </div>
          <div>
            <label class="text-bold">Количество</label>
            <input type="number" name="quantity" required>
          </div>
          <button type="submit" class="btn btn-primary mt-2">Создать</button>
        </form>
      </div>

      <div class="card">
        <h3 class="mb-4">Список заказов</h3>
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left p-2">ID</th>
              <th class="text-left p-2">Рецептура</th>
              <th class="text-left p-2">Количество</th>
              <th class="text-left p-2">Статус</th>
              <th class="text-left p-2">Действия</th>
            </tr>
          </thead>
          <tbody>
            {{ range .Orders }}
            <tr>
              <td class="p-2">{{ .ID }}</td>
              <td class="p-2">{{ .RecipeName }}</td>
              <td class="p-2">{{ .Quantity }}</td>
              <td class="p-2">{{ .Status }}</td>
              <td class="p-2">
                {{ if eq .Status "open" }}
                  <form method="post" action="/order/close" style="display:inline;">
                    <input type="hidden" name="id" value="{{ .ID }}">
                    <button type="submit" class="btn btn-primary btn-sm">Закрыть</button>
                  </form>
                {{ else }}
                  <span class="text-muted">Закрыт</span>
                {{ end }}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

  </section>
</main>

<script>
let ingredientIndex = 1;
function addIngredient() {
  const container = document.getElementById('ingredients-list');
  const div = document.createElement('div');
  div.className = 'flex gap-2 mb-2';
  div.innerHTML = `
    <select name="ingredients[${ingredientIndex}].tmc_id" required>
      {{ range .TMC }}
        <option value="{{ .ID }}">{{ .Name }}</option>
      {{ end }}
    </select>
    <input type="number" name="ingredients[${ingredientIndex}].quantity" placeholder="Количество" required>
  `;
  container.appendChild(div);
  ingredientIndex++;
}

function showTab(tab) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
  document.getElementById('tab-' + tab).classList.remove('hidden');
}
</script>
{{ end }}
