{{template "base" .}}

{{define "title"}}Перемещение{{end}}

{{define "main"}}
<section class="content">

  <!-- Топбар только с заголовком -->
  <div class="topbar flex justify-between items-center">
    <h2 id="section-title">Перемещения</h2>
  </div>

  <!-- Левая колонка уже, правая шире -->
  <div class="grid" style="display:grid;grid-template-columns:1.2fr 2.2fr;gap:1rem;margin-top:1rem;">

    <!-- LEFT: Заказы перемещения -->
    <div>
      <div class="card">
        <div class="table-header">
          <h3>Заказы перемещения</h3>
          <button class="add-btn" data-open-modal="move-create" title="Добавить">+</button>
        </div>

        <div class="table-wrap">
          <table class="table" id="table-move">
            <thead>
              <tr>
                <th style="width:8ch;">ID заказа</th>
                <th style="width:10ch;">ID маршрута</th>
                <th style="width:12ch;">ID транзита</th>
                <th style="width:22ch;">Статус</th>
                <th>Создан</th>
                <th>Завершён</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody id="table-move-body">
              <!-- наполняется через fetch -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div>

      <!-- Маршруты -->
      <div class="card mb-4">
        <div class="table-header">
          <h4>Маршруты</h4>
          <button class="add-btn" data-open-modal="route-create" title="Добавить">+</button>
        </div>

        <div class="table-wrap">
          <table class="table" id="table-routes">
            <thead>
              <tr>
                <th style="width:8ch;">ID</th>
                <th>Откуда</th>
                <th>Куда</th>
                <th>Транзитный склад</th>
                <th style="width:18ch;">Время</th>
              </tr>
            </thead>
            <tbody id="table-routes-body">
              <!-- наполняется через fetch -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Транзитные склады -->
      <div class="card mb-4">
        <div class="table-header">
          <h4>Транзитные склады</h4>
          <button class="add-btn" data-open-modal="transit-create" title="Добавить">+</button>
        </div>

        <div class="table-wrap">
          <table class="table" id="table-transits">
            <thead>
              <tr>
                <th style="width:8ch;">ID</th>
                <th>Тип</th>
                <th>Вместимость</th>
              </tr>
            </thead>
            <tbody id="table-transits-body">
              <!-- наполняется через fetch -->
            </tbody>
          </table>
        </div>
      </div>

    </div><!-- /RIGHT -->

  </div><!-- /grid -->

  <!-- МОДАЛЫ (пустые формы; наполняй через JS) -->

  <!-- Создать заказ перемещения -->
  <div id="modal-move-create" class="modal hidden" aria-hidden="true">
    <div class="modal-content">
      <h3>Создать заказ перемещения</h3>
      <form id="form-move-create">
        <div class="mb-4">
          <label>Маршрут</label>
          <select name="route_id" id="move-route" required></select>
        </div>

        <div class="mb-4">
          <label>Элементы (рецептура и количество)</label>
          <div id="move-items-list"></div>
          <div class="mt-2">
            <button type="button" class="btn" data-action="add-move-item">+ Добавить позицию</button>
          </div>
        </div>

        <div class="flex justify-end gap-2">
          <button type="button" class="btn" data-close-modal>Отмена</button>
          <button type="submit" class="btn btn-primary">Создать</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Создать маршрут -->
  <div id="modal-route-create" class="modal hidden" aria-hidden="true">
    <div class="modal-content">
      <h3>Создать маршрут</h3>
      <form id="form-route-create">
        <div class="mb-4"><label>Название</label><input name="name" required></div>
        <div class="mb-4"><label>Откуда (склад)</label><select name="from_id" id="route-from" required></select></div>
        <div class="mb-4"><label>Куда (склад)</label><select name="to_id" id="route-to" required></select></div>
        <div class="mb-4"><label>Транзит (опционально)</label><select name="transit_id" id="route-transit"><option value="">— нет —</option></select></div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn" data-close-modal>Отмена</button>
          <button type="submit" class="btn btn-primary">Создать</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Создать транзитный склад -->
  <div id="modal-transit-create" class="modal hidden" aria-hidden="true">
    <div class="modal-content">
      <h3>Создать транзитный склад</h3>
      <form id="form-transit-create">
        <div class="mb-4"><label>Название</label><input name="name" required></div>
        <div class="mb-4">
          <label>Тип</label>
          <select name="transport_type" id="transit-type" required>
            <option value="air">Воздушный</option>
            <option value="rail">Ж/д</option>
            <option value="road">Авто</option>
            <option value="sea">Морской</option>
          </select>
        </div>
        <div class="mb-4"><label>Вместимость</label><input name="capacity" type="number" min="0" step="0.01" required></div>
        <div class="mb-4"><label>Примечание / адрес</label><input name="note"></div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn" data-close-modal>Отмена</button>
          <button type="submit" class="btn btn-primary">Создать</button>
        </div>
      </form>
    </div>
  </div>

</section>
{{end}}
